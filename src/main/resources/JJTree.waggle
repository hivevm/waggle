// Derived from JavaCC 7.0.12: src/main/jjtree/JJTree.jjt, src/main/javacc/JavaCC.jj

grammar JJTreeParser;

options {
  NODE_MULTI: true,
  NODE_DEFAULT_VOID: true,
  NODE_SCOPE_HOOK: true,
  NODE_CLASS: "ASTNode",
  VISITOR: true,
  VISITOR_DATA_TYPE: "ASTWriter",
  JAVA_PACKAGE: "org.hivevm.waggle.jjtree",
  BASE_PARSER: "ASTParser"
}

/************************************************
 * THE JAVACC GRAMMAR SPECIFICATION STARTS HERE *
 ************************************************/
grammar_input() #Grammar =
  (
    < _GRAMMAR > <IDENTIFIER> < SEMICOLON >
    [ < _OPTIONS > < LBRACE > option_binding() (< COMMA > option_binding())* < RBRACE > ]
  ) #CompilationUnit(true)
  ( regular_expr_production() | bnf_production() ) +
  <EOF>
;

option_binding() #OptionBinding =
  <? var t = getToken(1); ?>
  <IDENTIFIER> < COLON > ( IntegerLiteral() | BooleanLiteral() | StringLiteral() )
  <? $BOOL = closeNodeScope(jjtree, $NODE, true); ?>
  <? setInputOption(t, this.token); ?>
;

/*
 * The lexical half of the language. The grammar of the grammar used to cover only BNF
 * productions, so it could not read a grammar that defines its tokens inline -- which is
 * every grammar this project maintains.
 */
regular_expr_production() #REProduction =
  regexpr_kind()
  [
    LOOKAHEAD(2) < LT > < STAR > < GT >
  | < LT > identifier() ( < COMMA > identifier() )* < GT >
  ]
  [ < LBRACKET > < _IGNORE_CASE > < RBRACKET > ]
  < ASSIGN > regexpr_spec() ( < BIT_OR > regexpr_spec() )*
  < SEMICOLON >
;

regexpr_kind =
  < _TOKEN >
| < _SPECIAL_TOKEN >
| < _SKIP >
| < _MORE >
;

regexpr_spec() #RESpec =
  regular_expression()
  [ Statement() ]
  [ < COLON > identifier() ]
;

bnf_production() #BNF =
<?
	Token t1;
	ASTBNF prod = $NODE;
	ASTNodeDescriptor nd = null;
	JJTNodeScope ns;
	ASTNode eu;
?>
  t1=identifier() [ < LPAREN > [ FormalParameter() ( < COMMA > FormalParameter() ) * ] < RPAREN > ]
  [ < COLON > Type() ]
  [ nd=node_descriptor() ]
<?
	prod.setName(t1.image);
	ns = new JJTNodeScope(prod, nd);
?>
  (
    <? $BOOL = closeNodeScope(jjtree, $NODE, true); ?>
    <? $NODE.node_scope = ns; ?> ) #BNFDeclaration
  < ASSIGN >
  (
    eu=expansion_choices(prod)
<?	$BOOL = closeNodeScope(jjtree, $NODE, true); ?>
<?
	$NODE.node_scope = ns;
	$NODE.expansion_unit = eu;
?>
  ) #BNFNodeScope
  < SEMICOLON >
<?	$BOOL = closeNodeScope(jjtree, $NODE, true); ?>
  <? addProduction(prod); ?>
;

expansion_choices(ASTProduction p) : ASTNode #BNFChoice(> 1) =
  expansion(p) ( < BIT_OR > expansion(p) )*
  <? $BOOL = closeNodeScope(jjtree, $NODE, jjtree.nodeArity() > 1); ?>
  <? return (ASTNode) jjtree.peekNode(); ?>
;

expansion(ASTProduction p) #BNFSequence(> 1) =
<?
	ASTNode eu;
	ASTNodeDescriptor nd = null;
?>
  ( LOOKAHEAD(1) ( < _LOOKAHEAD > < LPAREN > local_lookahead(p) < RPAREN > ) #BNFLookahead )?
  ( LOOKAHEAD(0, { notTailOfExpansionUnit() } )
    (
      eu=expansion_unit(p)
      [ nd=node_descriptor() ]
<?
	$BOOL = closeNodeScope(jjtree, $NODE, jjtree.nodeArity() > 1);
	if (jjtree.nodeCreated()) {
		$NODE.node_scope = new JJTNodeScope(p, nd);
		$NODE.expansion_unit = eu;
	}
?>
    ) #BNFExpansionScope(> 1)
  )+
;

local_lookahead(ASTProduction p) =
<?
	boolean commaAtEnd = false;
	boolean emptyLA = true;
?>
  [
    /*
     * The lookahead of 1 is to turn off the warning message that lets
     * us know that an expansion choice can also start with an integer
     * literal because a primary expression can do the same.  But we
     * know that this is what we want.
     */
    LOOKAHEAD(1)
    IntegerLiteral()
    <? emptyLA = false; ?>
  ]
  [ LOOKAHEAD(0, { checkEmptyLA(emptyLA, getToken(1)) } )
    < COMMA > <? commaAtEnd = true; ?>
  ]
  [ LOOKAHEAD(0, { checkEmpty(getToken(1)) } )
    expansion_choices(p)
    <? emptyLA = false; commaAtEnd = false; ?>
  ]
  [ LOOKAHEAD(0, { checkEmptyLAAndCommandEnd(emptyLA, commaAtEnd, getToken(1)) } )
    < COMMA > <? commaAtEnd = true; ?>
  ]
  [ LOOKAHEAD(0, { checkEmptyLAOrCommandEnd(emptyLA, commaAtEnd) } )
    < LBRACE > [ Expression() ] < RBRACE >
  ]
;

expansion_unit(ASTProduction p) : ASTNode =
<? Token t; ?>
(
  LOOKAHEAD(1)
  /*
   * We give this priority over primary expressions which use LOOKAHEAD as the
   * name of its identifier.
   */
  ( < _LOOKAHEAD > < LPAREN > local_lookahead(p) < RPAREN > ) #BNFLookahead
| Statement() #BNFAction
| ( < LBRACKET > expansion_choices(p) < RBRACKET > ) #BNFZeroOrOne
| LOOKAHEAD( identifier() | StringLiteral() | < LT > | Expression() < ASSIGN > )
(
  [
    LOOKAHEAD(Expression() < ASSIGN >)
    Expression() < ASSIGN >
  ]
  (
    regular_expression() [ < DOT > t=<IDENTIFIER>  ]
  | ( identifier() Arguments() ) #BNFNonTerminal
  )
) #BNFAssignment(> 1)
|
  t=< LPAREN > expansion_choices(p) < RPAREN >
  (
    < PLUS > #BNFOneOrMore(1)
  | < STAR > #BNFZeroOrMore(1)
  | < HOOK > #BNFZeroOrOne(1)
  | {} <? $BOOL = closeNodeScope(jjtree, $NODE, 1); ?> #BNFParenthesized(1)
  )
  <? ((ASTNode) jjtree.peekNode()).setFirstToken(t); ?>
)
<? return (ASTNode) jjtree.peekNode(); ?>
;

regular_expression =
  StringLiteral() #REStringLiteral
|
  LOOKAHEAD(3)
  (
    < LT > [ [ < HASH > ] identifier() < COLON > ] complex_regular_expression_choices() < GT >
  ) #RENamed
| LOOKAHEAD(2) ( < LT > identifier() < GT > ) #REReference
| ( < LT > < _EOF > < GT > ) #REEOF
;

complex_regular_expression_choices() #REChoice(> 1) =
  complex_regular_expression() ( < BIT_OR > complex_regular_expression() )*
;

complex_regular_expression() #RESequence(> 1) =
  ( complex_regular_expression_unit() )+
;

complex_regular_expression_unit =
<?Token t;?>
(
  StringLiteral() #REStringLiteral
| ( < LT > identifier() < GT > ) #REReference
| character_list()
| t=< LPAREN > complex_regular_expression_choices() < RPAREN >
  (
    < PLUS > #REOneOrMore(1)
  | < STAR > #REZeroOrMore(1)
  | < HOOK > #REZeroOrOne(1)
  | < LBRACE > IntegerLiteral() [ < COMMA >  [ IntegerLiteral() ] ] < RBRACE > #RRepetitionRange(1)
  | {} <? $BOOL = closeNodeScope(jjtree, $NODE, 1); ?> #REParenthesized(1)
  )
<? ((ASTNode) jjtree.peekNode()).setFirstToken(t); ?>
)
;

character_list() #RECharList =
  [ < TILDE > ] < LBRACKET > [ character_descriptor() ( < COMMA > character_descriptor() )* ] < RBRACKET >
;

character_descriptor() #CharDescriptor =
  StringLiteral() [ < MINUS > StringLiteral() ]
;

identifier() : Token =
  <? Token t; ?>
  t=<IDENTIFIER>
  <? return t; ?>
;

value() : Token =
  ( <INTEGER_LITERAL> | BooleanLiteral() )
  <? return token; ?>
;

/**********************************************
 * THE JJTREE PRODUCTIONS START HERE       *
 **********************************************/

node_descriptor() : ASTNodeDescriptor #NodeDescriptor =
<?
	Token t = null;
	String s = null;
?>
  < HASH >
  s=TypeParameter() <? $NODE.setName(s); ?>
  [
   LOOKAHEAD(1)
   < LPAREN >
      [ < GT > <? $NODE.setGreaterThan(); ?> ]
      t=value() <? $NODE.setExpressionText(t.image); ?>
   < RPAREN >
  ]
<?
	$BOOL = closeNodeScope(jjtree, $NODE, true);
	return $NODE;
?>
;

/**********************************************
 * THE JAVA GRAMMAR SPECIFICATION STARTS HERE *
 **********************************************/

/*
 * The following production defines Java identifiers - it
 * includes the reserved words of JavaCC also.
 */

TypeParameter() : String =
(
  <IDENTIFIER>
| < _LOOKAHEAD >
| < _IGNORE_CASE >
| < _GRAMMAR >
| < _OPTIONS >
| < _TOKEN >
| < _SPECIAL_TOKEN >
| < _MORE >
| < _SKIP >
| < _EOF >
)
<? return token.image; ?>
;

/*
 * Program structuring syntax follows.
 */
TypeParameters =
  < LT > TypeParameter() ( < COMMA > TypeParameter() )* < GT >
;

FormalParameter =
  Type() TypeParameter()
;


/*
 * Type, name and expression syntax follows.
 */
Type =
   LOOKAHEAD(2) ClassOrInterfaceType()
 | PrimitiveType()
;

ClassOrInterfaceType =
  <IDENTIFIER> [ LOOKAHEAD(2) TypeArguments() ]
;

TypeArguments =
  < LT > [ ClassOrInterfaceType() ] < GT >
;

PrimitiveType =
  < BOOLEAN >
| < CHAR >
| < INT >
;


/*
 * Expression syntax follows.
 */
Expression() #Expression =
  PrimaryPrefix() ( LOOKAHEAD(2) PrimarySuffix() )*
;

PrimaryPrefix =
  Literal()
| < LPAREN > Expression() < RPAREN >
| Name()
;

Name =
  TypeParameter()
  ( LOOKAHEAD(2) < DOT > TypeParameter() )*
;

PrimarySuffix =
  < LBRACKET > Expression() < RBRACKET >
| Arguments()
;

Literal =
  < NULL >
| <INTEGER_LITERAL>
| <FLOATING_POINT_LITERAL>
| <CHARACTER_LITERAL>
| <STRING_LITERAL>
| BooleanLiteral()
;

IntegerLiteral = <INTEGER_LITERAL> ;

BooleanLiteral = < TRUE > | < FALSE > ;

StringLiteral = <STRING_LITERAL> ;

/*
 * Parsing this fills "tokens" with all tokens of the arguments
 * excluding the parentheses at each end.
 */
Arguments =
  < LPAREN > [ ArgumentList() ] < RPAREN >
;

ArgumentList =
  Expression() ( < COMMA > Expression() )*
;

/*
 * Statement syntax follows.
 * Parsing this fills "tokens" with all tokens of the block
 * excluding the braces at each end.
 */
Statement =
  < ECODE_DATA > < ECODE_END >
| < LBRACE > ( Statement() )* < RBRACE >
;
/**********************************************
 * THE JAVACC TOKEN SPECIFICATION STARTS HERE *
 **********************************************/

/* JAVACC RESERVED WORDS: These are the only tokens in JavaCC but not in Java */

TOKEN =
  < _LOOKAHEAD: "LOOKAHEAD" >
| < _IGNORE_CASE: "IGNORE_CASE" >
| < _GRAMMAR: "grammar" >
| < _OPTIONS: "options" >
| < _TOKEN: "TOKEN" >
| < _SPECIAL_TOKEN: "SPECIAL_TOKEN" >
| < _MORE: "MORE" >
| < _SKIP: "SKIP" >
| < _EOF: "EOF" >
;

/*
 * The remainder of the tokens are exactly (except for the removal of tokens
 * as in the Java grammar and must be diff equivalent
 * (again with the exceptions above) to it.
 */

/* WHITE SPACE */

SPECIAL_TOKEN =
  " "
| "\t"
| "\n"
| "\r"
| "\f"
;

/* COMMENTS */

MORE =
  "//" : IN_SINGLE_LINE_COMMENT
| "/*" : IN_MULTI_LINE_COMMENT
| "<?" : PARSER_CODE
;


SPECIAL_TOKEN <IN_SINGLE_LINE_COMMENT>= <SINGLE_LINE_COMMENT: "\n" | "\r" | "\r\n" > : DEFAULT ;
SPECIAL_TOKEN <IN_MULTI_LINE_COMMENT>= <MULTI_LINE_COMMENT: "*/" > : DEFAULT ;


TOKEN <PARSER_CODE>=
  < ECODE_END: "?>" > : DEFAULT
| < ECODE_DATA: (~["?"] | "?" ~[">"])+ >
;

MORE <IN_SINGLE_LINE_COMMENT,IN_MULTI_LINE_COMMENT>= < ~[] > ;

/* JAVA RESERVED WORDS AND LITERALS */

TOKEN =
  < BOOLEAN: "boolean" >
| < INT: "int" >
| < CHAR: "char" >
| < NULL: "null" >
| < TRUE: "true" >
| < FALSE: "false" >
;

/* JAVA LITERALS */

TOKEN =
  < INTEGER_LITERAL:
      <DECIMAL_LITERAL> (["l","L"])?
    | <HEX_LITERAL> (["l","L"])?
    | <OCTAL_LITERAL> (["l","L"])?
  >
| < #DECIMAL_LITERAL: ["1"-"9"] (["0"-"9"])* >
| < #HEX_LITERAL: "0" ["x","X"] (["0"-"9","a"-"f","A"-"F"])+ >
| < #OCTAL_LITERAL: "0" (["0"-"7"])* >
| < FLOATING_POINT_LITERAL:
      <DECIMAL_FLOATING_POINT_LITERAL>
    | <HEXADECIMAL_FLOATING_POINT_LITERAL>
  >
| < #DECIMAL_FLOATING_POINT_LITERAL:
      (["0"-"9"])+ "." (["0"-"9"])* (<DECIMAL_EXPONENT>)? (["f","F","d","D"])?
    | "." (["0"-"9"])+ (<DECIMAL_EXPONENT>)? (["f","F","d","D"])?
    | (["0"-"9"])+ <DECIMAL_EXPONENT> (["f","F","d","D"])?
    | (["0"-"9"])+ (<DECIMAL_EXPONENT>)? ["f","F","d","D"]
  >
| < #DECIMAL_EXPONENT: ["e","E"] (["+","-"])? (["0"-"9"])+ >
| < #HEXADECIMAL_FLOATING_POINT_LITERAL:
     "0" ["x", "X"] (["0"-"9","a"-"f","A"-"F"])+ (".")? <HEXADECIMAL_EXPONENT> (["f","F","d","D"])?
   | "0" ["x", "X"] (["0"-"9","a"-"f","A"-"F"])* "." (["0"-"9","a"-"f","A"-"F"])+ <HEXADECIMAL_EXPONENT> (["f","F","d","D"])?
  >
| < #HEXADECIMAL_EXPONENT: ["p","P"] (["+","-"])? (["0"-"9"])+ >
| < CHARACTER_LITERAL:
    "'"
    ( (~["'","\\","\n","\r"])
      | ("\\"
        ( ["n","t","b","r","f","\\","'","\""]
        | ["0"-"7"] ( ["0"-"7"] )?
        | ["0"-"3"] ["0"-"7"] ["0"-"7"]
        )
      )
    )
    "'"
  >
| < STRING_LITERAL:
    "\""
    ( (~["\"","\\","\n","\r"])
      | ("\\"
        ( ["n","t","b","r","f","\\","'","\""]
        | ["0"-"7"] ( ["0"-"7"] )?
        | ["0"-"3"] ["0"-"7"] ["0"-"7"]
        )
      )
    )*
    "\""
  >
;

/* SEPARATORS */

TOKEN =
  < LPAREN: "(" >
| < RPAREN: ")" >
| < LBRACE: "{" >
| < RBRACE: "}" >
| < LBRACKET: "[" >
| < RBRACKET: "]" >
| < COMMA: "," >
| < SEMICOLON: ";" >
| < DOT: "." >
;

/* OPERATORS */

TOKEN =
  < ASSIGN: "=" >
| < GT: ">" >
| < LT: "<" >
| < TILDE: "~" >
| < HOOK: "?" >
| < HASH: "#" >
| < COLON: ":" >
| < PLUS: "+" >
| < MINUS: "-" >
| < STAR: "*" >
| < BIT_OR: "|" >
;

/* IDENTIFIERS */

TOKEN =
  < IDENTIFIER: <LETTER> (<PART_LETTER>)* >
| < #LETTER:
    // Approximates Character.isIdentifierStart. Deliberately over-accepts: this is a
    // strict superset of the per-script ranges it replaces, so every identifier that
    // lexed before still lexes. No other token starts with a non-ASCII character.
    [
      "$",
      "A"-"Z",
      "_",
      "a"-"z",
      "\u00a2"-"\uffff"
    ]
  >
| < #PART_LETTER:
    // Approximates Character.isIdentifierPart, likewise a strict superset. The low
    // ranges are the ignorable control characters Java counts as identifier parts.
    [
      "\u0000"-"\u0008",
      "\u000e"-"\u001b",
      "$",
      "0"-"9",
      "A"-"Z",
      "_",
      "a"-"z",
      "\u007f"-"\uffff"
    ]
  >
;
